# F-Spark frontend environment template
# Configure each Vercel/deployment environment separately. Never put backend
# database credentials, JWT secrets, or other server secrets in NEXT_PUBLIC_*.

# Required for production builds: staging | production
# Use a non-production value such as development locally.
NEXT_PUBLIC_APP_ENV=staging

# Browser API requests are deliberately same-origin in staging/production.
# Keep this blank so the browser calls /api/** on the frontend host.
NEXT_PUBLIC_API_BASE_URL=

# Server-only API upstream used by the Next.js /api/** rewrite.
# Staging: https://api-fspark.kusl.io.vn
# Production: leave blank when startup.f-spark.vn already reverse-proxies /api/**,
# or set the private/public backend origin if Next.js must perform the proxy.
API_UPSTREAM_URL=https://api-fspark.kusl.io.vn

# Direct STOMP WebSocket endpoint. WebSocket authentication uses the in-memory
# access token in the CONNECT header; the refresh cookie is not used here.
NEXT_PUBLIC_WS_URL=wss://api-fspark.kusl.io.vn/ws

# Google OAuth 2.0 Web Client ID allowed for the matching frontend origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional Google account chooser hint.
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=fpt.edu.vn

# Optional Playwright target for local/CI smoke tests only.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Deployment examples (comments only)
#
# LOCAL DEVELOPMENT
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# API_UPSTREAM_URL=
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<local-google-web-client-id>
#
# STAGING — apply to both Vercel frontend projects
# NEXT_PUBLIC_APP_ENV=staging
# NEXT_PUBLIC_API_BASE_URL=
# API_UPSTREAM_URL=https://api-fspark.kusl.io.vn
# NEXT_PUBLIC_WS_URL=wss://api-fspark.kusl.io.vn/ws
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<staging-google-web-client-id>
#
# PRODUCTION — frontend and API share https://startup.f-spark.vn
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_API_BASE_URL=
# API_UPSTREAM_URL=
# NEXT_PUBLIC_WS_URL=wss://startup.f-spark.vn/ws
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<production-google-web-client-id>
