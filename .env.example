NEXT_PUBLIC_API_BASE_URL=https://api-fspark.kusl.io.vn

# Optional explicit STOMP endpoint; defaults to API_BASE_URL with ws/wss + /ws.
NEXT_PUBLIC_WS_URL=wss://api-fspark.kusl.io.vn/ws

# Google OAuth 2.0 Web Client ID used by Google Identity Services.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional account chooser hint, for example fpt.edu.vn.
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=
